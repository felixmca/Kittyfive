# ── Public (safe in the browser) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key: not used by v1 (orders are server-only); reserved for
# the phase-4 live "where is Kitty" realtime subscription.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server only ───────────────────────────────────────────────────────────────
# Stripe: sk_test_… while building, sk_live_… in Vercel Production only.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the Dashboard webhook endpoint in prod.
STRIPE_WEBHOOK_SECRET=
# Supabase service role — NEVER expose to the client; used only in route handlers.
SUPABASE_SERVICE_ROLE_KEY=
# Print on demand. Printful UK is the primary (see docs/ROADMAP.md); set these
# and the site orders from Printful. Register the webhook as
#   https://<site>/api/webhooks/pod?secret=<PRINTFUL_WEBHOOK_SECRET>
# with types package_shipped, order_updated, order_failed, order_canceled.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=
# PRINTFUL_CONFIRM=0 keeps orders as drafts for manual approval.
# PRINTIFY_SEND_TO_PRODUCTION=0 holds Printify orders instead of sending at once.
# Printify (fallback; used only when the Printful pair above is empty)
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=
# Chat with Kitty
ANTHROPIC_API_KEY=
# Email: order confirmations / tracking, and story emails (Phase 5). Needs a
# domain verified in Resend (vercel.app cannot be).
RESEND_API_KEY=
EMAIL_FROM=Kitty <kitty@example.com>
# Resend → Webhooks → https://<site>/api/webhooks/resend (email.bounced,
# email.complained): its signing secret (whsec_…). Also needs
# SUPABASE_SERVICE_ROLE_KEY to mark addresses that bounce.
RESEND_WEBHOOK_SECRET=
