# ── Public (safe in the browser) ─────────────────────────────────────────────
# The site's own address. Stripe return URLs, product images and the /print
# files Printful fetches are built from it, so in Vercel it must be https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase: the project URL and its publishable key (sb_publishable_…; a legacy
# anon key also works as NEXT_PUBLIC_SUPABASE_ANON_KEY). Both are public by
# design: row level security decides who can do what. Leave them empty for
# demo mode. Full setup: docs/SELF-HOSTING.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server only ───────────────────────────────────────────────────────────────
# Stripe: sk_test_… while building, sk_live_… in Vercel Production only.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the Dashboard webhook endpoint in prod.
STRIPE_WEBHOOK_SECRET=
# Supabase service role — NEVER expose to the client; used only in route handlers.
SUPABASE_SERVICE_ROLE_KEY=
# Print on demand. Printful UK is the primary (docs/GO-LIVE.md). The token is
# account-level (Printful → Settings → API); the store id is the "Manual order /
# API" store (Stores → Connect via API). Both are needed, or the app stays on
# the demo provider. `node scripts/printful.mjs status` lists the stores.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
# A long random string. Printful v1 webhooks are unsigned, so it rides in the
# URL; register with `node scripts/printful.mjs webhooks register https://<site>`
# (it subscribes to package_shipped, order_updated, order_failed, order_canceled
# and five more, mapped in src/lib/commerce/pod/printful.ts).
PRINTFUL_WEBHOOK_SECRET=
# Default (unset or 1): each order is created as a draft and confirmed at once,
# which charges the Printful billing method. 0: leave it as a draft for review
# and confirm from /admin ("Confirm at Printful"), with
# `node scripts/printful.mjs orders confirm <id> --yes`, or in the Printful
# dashboard.
# PRINTFUL_CONFIRM=1
# Printify (fallback; used only when the Printful pair above is empty). No
# catalog fallback: record the shop's ids with `node scripts/pod-ids.mjs
# --write --map=…`. PRINTIFY_SEND_TO_PRODUCTION=0 holds orders instead of
# sending them to production at once.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=
# PRINTIFY_SEND_TO_PRODUCTION=1
# Store ids: src/config/pod-ids.json is written by `products sync` and
# committed; POD_IDS_JSON (the same JSON in an env var) overrides it. Harness
# only (scripts/verify-commerce.mjs), like STRIPE_API_BASE / PRINTFUL_API_URL /
# PRINTIFY_API_URL, which point the adapters at mock servers. Never set any of
# these in a real deployment: the three base URLs are ignored in a production
# build unless they point at localhost / 127.0.0.1, and POD_IDS_JSON is ignored
# on Vercel. /api/admin/status lists any that are set under "overrides".
# STRIPE_API_BASE=
# PRINTFUL_API_URL=
# PRINTIFY_API_URL=
# POD_IDS_JSON=
# Chat with Kitty
ANTHROPIC_API_KEY=
# Email: order confirmations / tracking, and story emails (Phase 5). Needs a
# domain verified in Resend (vercel.app cannot be).
RESEND_API_KEY=
EMAIL_FROM=Kitty <kitty@example.com>
# Resend → Webhooks → https://<site>/api/webhooks/resend (email.bounced,
# email.complained): its signing secret (whsec_…). Also needs
# SUPABASE_SERVICE_ROLE_KEY to mark addresses that bounce.
RESEND_WEBHOOK_SECRET=
